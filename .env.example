# Copy this file to .env and fill in your EmailJS credentials
# (https://dashboard.emailjs.com) to enable the contact form.
VITE_APP_EMAILJS_SERVICE_ID=
VITE_APP_EMAILJS_TEMPLATE_ID=
VITE_APP_EMAILJS_PUBLIC_KEY=

# Optional: link for the RESUME button, e.g. a Google Drive share link.
# Update the file in Drive ("Manage versions") and the site picks it up
# without a redeploy. Leave empty to use public/resume.pdf.
VITE_RESUME_URL=
